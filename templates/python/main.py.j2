#!/usr/bin/env python3
"""{{ project.name }} — MCP server generated by Unified MCP Studio."""

import asyncio

from mcp.server import Server
from mcp.server.stdio import stdio_server
from mcp.types import TextContent, Tool

{% for tool in tools %}
from tools.{{ tool.name }} import handle as {{ tool.name }}_handle
{% endfor %}
{% if not tools %}
# No tools defined yet — add tools in Unified MCP Studio and regenerate.
{% endif %}

app = Server("{{ project.name }}")


@app.list_tools()
async def list_tools() -> list[Tool]:
    return [
{% for tool in tools %}
        Tool(
            name="{{ tool.name }}",
            description={{ tool.description | tojson }},
            inputSchema={{ tool.input_schema | topython }},
        ),
{% endfor %}
    ]


@app.call_tool()
async def call_tool(name: str, arguments: dict) -> list[TextContent]:
{% for tool in tools %}
    if name == "{{ tool.name }}":
        result = await {{ tool.name }}_handle(arguments)
        return [TextContent(type="text", text=str(result))]
{% endfor %}
    raise ValueError(f"Unknown tool: {name}")


async def main() -> None:
    async with stdio_server() as (read_stream, write_stream):
        await app.run(
            read_stream,
            write_stream,
            app.create_initialization_options(),
        )


if __name__ == "__main__":
    asyncio.run(main())
