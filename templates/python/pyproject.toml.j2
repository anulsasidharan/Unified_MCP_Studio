[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project.name | lower | replace(' ', '-') }}-mcp-server"
version = "0.1.0"
description = "{{ project.name }} MCP server generated by Unified MCP Studio"
requires-python = ">=3.11"
dependencies = [
    "mcp>=1.0",
]

[tool.setuptools.packages.find]
where = ["."]
include = ["tools*"]
