# Browser-accessible public config only (no service secrets).
# Local dev: leave empty so requests go to this Next app (/api/v1/...) and next.config.mjs
# rewrites proxy to the backend (no CORS). Or set the full API URL if you prefer direct calls.
NEXT_PUBLIC_API_BASE_URL=
# Server-side rewrite target (next dev / next start); not exposed to the browser.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
