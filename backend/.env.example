# Copy to .env and adjust. Never commit real secrets.
APP_NAME=Unified MCP Studio API
ENVIRONMENT=development
DEBUG=true

# API (docs/API_SPEC.md — base /api/v1)
API_V1_PREFIX=/api/v1

# CORS: comma-separated browser origins (localhost vs 127.0.0.1 are different origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (docker-compose defaults; async driver for future SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://mcpstudio:mcpstudio@127.0.0.1:5432/mcpstudio

# Redis / Celery (Phase 4+)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT (Phase 1 auth — use a long random secret in production; GCP: Secret Manager)
JWT_SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Codegen / artifacts (Phase 4)
CODEGEN_TEMPLATE_ROOT=
ARTIFACT_LOCAL_DIR=./var/artifacts
GCS_BUCKET=
GCS_SIGN_TTL_SECONDS=3600
CODEGEN_USE_CELERY=false

# Sandbox (Phase 5)
SANDBOX_WORKSPACE_ROOT=./var/sandbox
SANDBOX_SUBPROCESS_TIMEOUT_SECONDS=60
SANDBOX_MAX_OUTPUT_BYTES=256000

# Deploy worker placeholders (Phase 7)
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_RUN_SERVICE_NAME=

# Optional Anthropic proxy (Phase 5 optional)
ANTHROPIC_API_KEY=
