# Copy to .env and adjust. Never commit real secrets.
APP_NAME=Unified MCP Studio API
ENVIRONMENT=development
DEBUG=true

# API (docs/API_SPEC.md — base /api/v1)
API_V1_PREFIX=/api/v1

# CORS: comma-separated browser origins (Next.js dev server by default)
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (async driver required: postgresql+asyncpg://)
#
# Defaults match docker-compose.yml: user/password/db = mcpstudio / mcpstudio / mcpstudio.
# From repo root: docker compose up -d postgres   then wait until healthy.
#
# API on host (uvicorn on Windows/macOS/Linux): host 127.0.0.1, port = host-mapped port
# (default 5432, or set POSTGRES_PORT in .env next to compose and use that port here).
#
# API in a container on the same compose network: host = service name `postgres`, port 5432.
#
# If login still fails after changing POSTGRES_PASSWORD: Postgres keeps the old password in the
# named volume until you remove it (docker compose down -v) or align DATABASE_URL with the
# password that was used when the data directory was first created.
#
DATABASE_URL=postgresql+asyncpg://mcpstudio:mcpstudio@127.0.0.1:5432/mcpstudio

# Redis / Celery (Phase 4+)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT (Phase 1 auth — use a long random secret in production; GCP: Secret Manager)
JWT_SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
