# Copy to .env and adjust. Never commit real secrets.
APP_NAME=Unified MCP Studio API
ENVIRONMENT=development
DEBUG=true

# API (docs/API_SPEC.md — base /api/v1)
API_V1_PREFIX=/api/v1

# CORS: comma-separated browser origins (Next.js dev server by default)
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (docker-compose defaults; async driver for future SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://mcpstudio:mcpstudio@127.0.0.1:5432/mcpstudio

# Redis / Celery (Phase 4+)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT (Phase 1 auth — use a long random secret in production; GCP: Secret Manager)
JWT_SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
